# Local MongoDB example:
MONGODB_URI=mongodb://127.0.0.1:27017/study_space

# For MongoDB Atlas, replace the value with your connection string.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/study_space?retryWrites=true&w=majority

PORT=3000

# Generate a private value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret
